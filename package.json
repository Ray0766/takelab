{
  "name": "takelab",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first comparison desk for AI video takes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/collect-licenses.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sync": "node scripts/check-sync.mjs",
    "test:frames": "node scripts/generate-frame-fixtures.mjs && playwright test tests/e2e/frames.spec.ts",
    "check": "npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fix-webm-duration/fix": "^1.0.1",
    "@noble/hashes": "2.4.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.65.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
